FROM ruby:3.3-slim AS builder

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential libssl-dev libyaml-dev pkg-config git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV BUNDLE_DEPLOYMENT="1" \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

COPY . .
RUN chmod +x bin/*

FROM ruby:3.3-slim AS runtime

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      libssl3 libyaml-0-2 ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash rails

WORKDIR /app

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_PATH="/usr/local/bundle"

COPY --from=builder --chown=rails:rails /usr/local/bundle /usr/local/bundle
COPY --from=builder --chown=rails:rails /app /app

USER rails

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3001/up || exit 1

CMD ["bin/rails", "server", "-p", "3001", "-b", "0.0.0.0"]
