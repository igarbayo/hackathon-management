# Copy this file as .env.production on the Raspberry Pi (outside git) and fill
# in the real values. It is never committed with real data.

MONGODB_URI=
# Valkey runs next to api and worker in docker-compose.prod.yml.
REDIS_URL=redis://redis:6379/0
APP_URL=https://hackboard.ignaciogarbayo.com
API_URL=https://api-hackboard.ignaciogarbayo.com
SESSION_SECRET=
RAILS_MASTER_KEY=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The app no longer uses a shared GEMINI_API_KEY: each person sets their own in
# their profile (Settings), encrypted with GEMINI_API_KEY_ENCRYPTION_KEY.
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
GEMINI_API_KEY_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

WEBHOOK_SECRETS_KEY=
