{
  "name": "hackboard",
  "version": "0.1.0",
  "description": "CLI de Hackboard: instala hooks de Claude Code y envía eventos de actividad a la API.",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "hackboard",
    "hackathon",
    "claude-code",
    "hooks",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igarbayo/hackathon-management.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/igarbayo/hackathon-management/issues"
  },
  "bin": {
    "hackboard": "dist/bin/hackboard.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
