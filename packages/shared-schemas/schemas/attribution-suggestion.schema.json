{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttributionSuggestion",
  "description": "Output of attribution layer 3, AI inference (05-atribucion.md#capa-3--inferencia-con-ia)",
  "type": "object",
  "required": ["assignments"],
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "feature_key", "confidence", "reason"],
        "additionalProperties": false,
        "properties": {
          "group_id": { "type": "string" },
          "feature_key": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
